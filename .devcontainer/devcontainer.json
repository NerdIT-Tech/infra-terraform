{
    "image": "mcr.microsoft.com/devcontainers/base:0-ubuntu-22.04",
    "features": {
        "ghcr.io/devcontainers/features/terraform:1": {},
        "ghcr.io/roul/devcontainer-features/bitwarden-cli:1": {},
        "ghcr.io/devcontainers/features/aws-cli:1": {},
        "ghcr.io/devcontainers-extra/features/tflint:1": {},
        "ghcr.io/jasonthedeveloper/features/trivy:1": {},
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/devcontainers-extra/features/claude-code:2": {},
        "ghcr.io/nerdit-tech/devcontainer-features/claude-cache:0": {}
    },
    "postStartCommand": {
        "git-signing": "git config --global gpg.format ssh && git config --global commit.gpgsign true && git config --global tag.gpgsign true && git config --global gpg.ssh.defaultKeyCommand 'sh -c \"echo key::$(ssh-add -L | head -n1)\"'"
    }
}
